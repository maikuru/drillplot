{
  "name": "drillplot",
  "version": "0.1.0",
  "description": "Draw pickleball drill diagrams on a to-scale court and export editable SVG.",
  "license": "MIT",
  "author": "Mike LP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maikuru/drillplot.git"
  },
  "homepage": "https://maikuru.github.io/drillplot/",
  "bugs": {
    "url": "https://github.com/maikuru/drillplot/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "keywords": [
    "pickleball",
    "drill",
    "diagram",
    "svg",
    "coaching",
    "court"
  ],
  "sideEffects": [
    "./dist/editor.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./schema": "./schema/drill-diagram.v1.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/write-type-entries.mjs",
    "build:demo": "npm run build && node scripts/copy-demo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "ajv": "8.20.0",
    "jsdom": "26.1.0",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
