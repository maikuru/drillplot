{
  "name": "drillplot",
  "version": "0.1.0",
  "description": "Draw pickleball drill diagrams on a to-scale court and export editable SVG.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pickleball",
    "drill",
    "diagram",
    "svg",
    "coaching",
    "court"
  ],
  "sideEffects": [
    "./dist/editor.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./schema": "./schema/drill-diagram.v1.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsup",
    "build:demo": "npm run build && node scripts/copy-demo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "ajv": "8.17.1",
    "jsdom": "26.1.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
